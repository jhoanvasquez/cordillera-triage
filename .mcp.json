{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,projects"
      }
    },
    "cordillera": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/run_cordillera_mcp.sh"]
    }
  }
}
